---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Awakening Dignity Practice Group"
  description="A free weekly Aylsham and online practice group exploring dignity, compassion, meditation, and meaningful connection."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Free Monday practice group</p>
      <h1>Awakening Dignity Across the Globe</h1>
      <p class="lede">
        A six-month journey into inner dignity, compassion, and meaningful
        connection, meeting weekly in Aylsham and online. The next local group
        begins on Monday 19 October 2026.
      </p>
      <div class="button-row">
        <a class="button" href="mailto:hello@stillground.co.uk">Ask Jane about joining</a>
        <a class="button secondary" href="https://www.samyeinstitute.org/awakening-dignity-across-the-globe/">
          Samye Institute information
        </a>
      </div>
    </div>
    <figure class="hero-media">
      <img
        src={`${base}assets/practice-group/awakening-dignity-across-the-globe.webp`}
        alt="Awakening Dignity Across the Globe programme image from Samye Institute"
        width="900"
        height="900"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption>Awakening Dignity Across the Globe</figcaption>
    </figure>
  </section>

  <section class="statement">
    <p>
      Rooted in ancient Buddhist wisdom yet fully accessible to all, this is not
      a religious programme. The book and online course are helpful resources,
      but they are not required to take part in the local practice group.
    </p>
  </section>

  <section class="split">
    <div>
      <p class="eyebrow">Next cycle</p>
      <h2>Starting again on Monday 19 October 2026</h2>
      <p>
        Jane facilitates a local practice group for the Awakening Dignity
        programme from the Samye Institute. The group will explore the programme
        for a second time from Monday 19 October 2026.
      </p>
      <p>
        The current group began in March 2026 and continues into October before
        the next local group starts from the beginning.
      </p>
      <p>
        If you are interested, getting in touch now gives you time to arrange
        your schedule before the new group begins.
      </p>
    </div>
    <div class="note-panel">
      <p class="small-label">Register interest</p>
      <p>
        Email Jane if you would like to join the new October group or ask
        whether the course is right for you.
      </p>
      <a href="mailto:hello@stillground.co.uk">Email Jane</a>
    </div>
  </section>

  <section class="feature-grid" aria-label="What participants explore">
    <article>
      <h3>Basic goodness</h3>
      <p>Ground your life in the dignity and basic goodness already present.</p>
    </article>
    <article>
      <h3>Difficult emotions</h3>
      <p>Work with habitual patterns and emotional difficulty with more kindness.</p>
    </article>
    <article>
      <h3>Daily stability</h3>
      <p>Meet life's challenges with stability, clarity, compassion, and ease.</p>
    </article>
  </section>

  <section class="split">
    <div>
      <p class="eyebrow">Weekly format</p>
      <h2>Read, meditate, contemplate, integrate</h2>
      <p>
        Each weekly session includes readings and videos to deepen understanding,
        meditation exercises to enhance experience, and contemplation to help
        integrate learning into daily life.
      </p>
      <p>
        Participants receive home practice resources each week to help build a
        steady, meaningful routine between sessions.
      </p>
    </div>
    <div class="note-panel">
      <p class="small-label">Meeting details</p>
      <ul class="list-clean">
        <li>Mondays, 9:30-11:00am GMT.</li>
        <li>Please arrive by 9:15am for a prompt start.</li>
        <li>New course starts Monday 19 October 2026.</li>
        <li>Aylsham, Norfolk, also available online.</li>
        <li>Bring a notebook and pen.</li>
      </ul>
    </div>
  </section>

  <section class="contact-band">
    <div>
      <p class="eyebrow">Questions welcome</p>
      <h2>Contact Jane before the first session</h2>
      <p>Jane can explain the local group, online access, and the optional resources.</p>
    </div>
    <a class="button" href="mailto:hello@stillground.co.uk">Email Jane</a>
  </section>
</BaseLayout>
