---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Still Ground in North Norfolk</p>
      <h1>Still Ground</h1>
      <p class="lede">
        Jane teaches yoga, meditation, relaxation and dreamwork in small groups
        in Aylsham and one to one, online or in person. Her approach is personal,
        spacious, and welcoming to beginners and experienced practitioners.
      </p>
      <div class="button-row">
        <a class="button" href={`${base}work-with-jane/`}>Explore one-to-one sessions</a>
        <a class="button secondary" href={`${base}autumn-winter-workshops/`}>See group sessions</a>
      </div>
    </div>
    <figure class="hero-media image-contain">
      <picture>
        <source
          srcset={`${base}assets/home/spacious-beach-640.webp 640w, ${base}assets/home/spacious-beach-900.webp 900w, ${base}assets/home/spacious-beach-1500.webp 1500w`}
          sizes="(max-width: 860px) 100vw, 54vw"
          type="image/webp"
        />
        <img
          src={`${base}assets/home/spacious-beach-900.webp`}
          alt="An open North Norfolk beach beneath a wide sky"
          width="900"
          height="675"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </section>

  <section class="statement" aria-label="Core promise">
    <p>
      Meditation does not need to be solitary or one-size-fits-all. Jane creates
      grounded spaces where people can learn and practise together, or receive
      individual guidance shaped around what they need.
    </p>
  </section>

  <section class="offer-grid" aria-label="Current offerings">
    <h2 class="sr-only">Current offerings</h2>
    <article>
      <p class="small-label">Save the dates</p>
      <h3>Autumn and winter workshops</h3>
      <p>
        Yoga Nidra Nights, the Hidden Language of Hatha Yoga, the Kundalini Yoga
        day, the Monday group, and future day retreats for the coming months.
      </p>
      <a href={`${base}autumn-winter-workshops/`}>See the workshop schedule</a>
    </article>
    <article>
      <p class="small-label">Past event</p>
      <h3>A day of meditation and relaxation</h3>
      <p>
        A small, nourishing day in Aylsham with meditation, gentle accessible
        yoga, breathing practices, Yoga Nidra, vegan lunch, refreshments, and
        spacious time to rest.
      </p>
      <a href={`${base}day-retreat/`}>Read the day retreat details</a>
    </article>
    <article>
      <p class="small-label">Private weekend</p>
      <h3>Learn to meditate</h3>
      <p>
        A private, structured weekend introduction in Aylsham for one guest:
        Buddhist-informed, personal, and suitable for complete beginners.
      </p>
      <a href={`${base}learn-to-meditate/`}>See the meditation weekend</a>
    </article>
    <article>
      <p class="small-label">Free weekly group</p>
      <h3>Awakening Dignity practice group</h3>
      <p>
        A six-month Monday morning journey into dignity, compassion, meditation,
        contemplation, and meaningful connection. Available in Aylsham and
        online.
      </p>
      <a href={`${base}awakening-dignity/`}>Explore the practice group</a>
    </article>
  </section>

  <section class="section section-narrow">
    <p class="eyebrow">With Jane</p>
    <h2>Presence without performance</h2>
    <p>
      Jane has taught yoga since 1999 and meditated daily since 2007. She offers
      space for people to discover what yoga, meditation, relaxation and
      dreamwork can bring to their own lives.
    </p>
  </section>

  <section class="feature-grid" aria-label="Ways to work with Jane">
    <article>
      <p class="small-label">One-to-one</p>
      <h3>Yoga, meditation and relaxation</h3>
      <p>
        Private sessions shaped around you, online worldwide or in person in
        North Norfolk. Go at your own pace.
      </p>
      <a href={`${base}work-with-jane/`}>Explore one-to-one sessions</a>
    </article>
    <article>
      <p class="small-label">Dreamwork</p>
      <h3>What dreams are carrying</h3>
      <p>
        Gentle one-to-one exploration of dreams, symbols, recurring images, and
        the meaning that wants to emerge from within you.
      </p>
      <a href={`${base}dreamwork/`}>Read about dreamwork</a>
    </article>
    <article>
      <p class="small-label">Immersive</p>
      <h3>Private weekends</h3>
      <p>
        Personal retreats and a structured learn-to-meditate weekend, both
        private and held one guest at a time in Aylsham.
      </p>
    </article>
    <article>
      <p class="small-label">Solo practice</p>
      <h3>The Retreat</h3>
      <p>
        A tiny, self-catering practice cabin near Aylsham for solo retreat
        stays of 5 to 28 nights.
      </p>
    </article>
  </section>

  <section class="retreat-feature">
    <div class="soft-panel">
      <p class="eyebrow">The personal retreat</p>
      <h2>A weekend shaped around spaciousness</h2>
      <p>
        One guest at a time. A few gentle anchor points create rhythm, while most
        of the weekend remains yours: walking, resting, journaling, sleeping, or
        doing absolutely nothing.
      </p>
      <a class="button" href={`${base}personal-retreats/`}>Explore personal retreats</a>
    </div>
    <figure class="retreat-image image-contain">
      <img
        src={`${base}assets/personal-retreats/beach-retreat.webp`}
        alt="Open beach, sea, and sky for a spacious personal retreat"
        width="760"
        height="570"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Personal retreat</figcaption>
    </figure>
  </section>

  <section class="split">
    <div>
      <p class="eyebrow">The Retreat</p>
      <h2>Tiny, private, and intentionally simple</h2>
      <p>
        A tiny private cabin in rural Norfolk for solo retreat guests. It is
        small by design: a contained, quiet, self-catering place for sitting,
        simplifying, and being with practice.
      </p>
      <a class="button secondary" href={`${base}retreatcottage/`}>See retreat details</a>
    </div>
    <div class="note-panel">
      <p class="small-label">Practical</p>
      <p>Solo guests only. Minimum 5 nights, maximum 28 nights.</p>
      <p>No WiFi, no TV, and limited mobile signal at the top of the garden.</p>
      <p>Near Itteringham, Blickling Hall, Aylsham, and the North Norfolk coast.</p>
    </div>
  </section>

  <section class="contact-band" id="contact">
    <div>
      <p class="eyebrow">Begin gently</p>
      <h2>A free 20-minute introductory call is available</h2>
      <p>No preparation needed. Just come as you are.</p>
    </div>
    <a class="button" href="mailto:hello@stillground.co.uk">Email Jane</a>
  </section>
</BaseLayout>
