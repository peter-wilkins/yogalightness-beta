---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout description="Yoga Nidra, yoga, meditation and dreamwork in Aylsham, North Norfolk and online, with Jane. Small groups, one-to-one sessions, personal retreats and a self-catering cabin.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Still Ground in North Norfolk</p>
      <h1>Still Ground</h1>
      <p class="retreat-tagline">Yoga Nidra, yoga, meditation, dreamwork and time away, in Aylsham, North Norfolk and online.</p>
      <p class="lede">
        I teach yoga, Yoga Nidra, meditation and dreamwork, in small groups, one
        to one, and on private retreats, in Aylsham, North Norfolk, and online.
        Beginners are welcome, and so are people who&rsquo;ve practised for years.
      </p>
      <div class="button-row">
        <a class="button" href={`${base}work-with-jane/`}>Explore one-to-one sessions</a>
        <a class="button secondary" href={`${base}autumn-winter-workshops/`}>See group sessions</a>
      </div>
    </div>
    <figure class="hero-media image-contain">
      <picture>
        <img
          src={`${base}assets/home/lotus-home.jpg`}
          alt="Pink lotus in bloom on a pond"
          width="3000"
          height="1993"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </section>

  <section class="statement" aria-label="Core promise">
    <p>
      These practices give you time and space to discover what they can do for
      you, whether you join a small group or work with me one to one.
    </p>
  </section>

  <section class="section" aria-label="What's coming up">
    <h2>What&rsquo;s coming up</h2>
    <div class="offer-grid">
    <article>
      <h3>Yoga Nidra Night</h3>
      <p>
        Fridays, 6-8pm, from 6 November. You lie down on a warm floor and I
        guide you into deep relaxation. You stay awake, but profoundly relaxed.
      </p>
    </article>
    <article>
      <h3>The Hidden Language of Hatha Yoga</h3>
      <p>
        Saturday mornings, from 12 December. The symbolism and hidden meanings
        behind traditional yoga practices, with breathing, relaxation and meditation.
      </p>
    </article>
    <article>
      <h3>Introduction to Kundalini Yoga</h3>
      <p>
        A day on Saturday 20 March. Reflective study of the chakra system as a
        map of inner life, in the Yasodhara tradition.
      </p>
    </article>
    <article>
      <h3>Monday meditation group</h3>
      <p>
        Free, weekly, in Aylsham and online. New members are welcome until
        mid-January.
      </p>
    </article>
    <article>
      <h3>Day retreats</h3>
      <p>
        A full day of meditation, movement, breathing and Yoga Nidra, with a
        homemade vegan lunch. I hold a few each year, and dates will follow.
      </p>
    </article>
    </div>
    <a class="button" href={`${base}autumn-winter-workshops/`}>See the full schedule</a>
  </section>

  <section class="section section-narrow">
    <h2>Learn to meditate</h2>
    <p>
      A structured introductory weekend in Aylsham, for one person at a time.
      It&rsquo;s suitable for complete beginners.
    </p>
    <a href={`${base}learn-to-meditate/`}>See the meditation weekend</a>
  </section>

  <section class="section section-narrow">
    <h2>One to one</h2>
    <p>
      Private sessions in yoga, meditation and relaxation, or in dreamwork.
      They&rsquo;re shaped around you, and take place online or in person.
    </p>
    <p>
      <a href={`${base}work-with-jane/`}>Explore one-to-one sessions</a> &middot;
      <a href={`${base}dreamwork/`}>Read about dreamwork</a>
    </p>
  </section>

  <section class="section section-narrow">
    <h2>Time away</h2>
  </section>
  <section class="retreat-feature">
    <div class="soft-panel">
      <h3>Personal retreats</h3>
      <p>
        A weekend for one person, with a few anchor points and plenty of time
        for walking, resting, journaling, or doing nothing.
      </p>
      <a class="button" href={`${base}personal-retreats/`}>Explore personal retreats</a>
    </div>
    <figure class="retreat-image image-contain">
      <img
        src={`${base}assets/personal-retreats/beach-retreat.webp`}
        alt="Open beach, sea, and sky for a spacious personal retreat"
        width="760"
        height="570"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Personal retreat</figcaption>
    </figure>
  </section>

  <section class="split">
    <div>
      <h3>The Retreat</h3>
      <p>
        A small self-catering cabin near Aylsham, for solo guests staying 5 to
        28 nights. There&rsquo;s no WiFi and no TV, and mobile signal is limited,
        so you may need to go to the top of the garden for it. It&rsquo;s close
        to Itteringham, Blickling Hall, Aylsham and the North Norfolk coast.
      </p>
      <a class="button secondary" href={`${base}retreatcottage/`}>See retreat details</a>
    </div>
    <div class="note-panel">
      <p class="small-label">Practical</p>
      <p>Solo guests only. Minimum 5 nights, maximum 28 nights.</p>
      <p>No WiFi, no TV, and limited mobile signal at the top of the garden.</p>
      <p>Near Itteringham, Blickling Hall, Aylsham, and the North Norfolk coast.</p>
    </div>
  </section>

  <section class="section section-narrow">
    <h2>A little about me</h2>
    <p>
      Holding space for people to experience the joy of their own discovery is
      deeply fulfilling. I&rsquo;ve taught yoga since 1999, and meditated every
      day since 2007.
    </p>
    <a href={`${base}work-with-jane/`}>Read more about me</a>
  </section>

  <section class="contact-band" id="contact">
    <div>
      <h2>Begin gently</h2>
      <p>
        If you&rsquo;re not sure where to start, book a free 20-minute
        introductory call. There&rsquo;s nothing to prepare. Tell me what
        you&rsquo;re looking for, and we&rsquo;ll see what suits you.
      </p>
    </div>
    <a class="button" href="mailto:hello@stillground.co.uk">Email Jane</a>
  </section>
</BaseLayout>
