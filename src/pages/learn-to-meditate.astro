---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Learn to Meditate in a Weekend | Still Ground"
  description="A private meditation weekend shaped around you, with four individual teaching sessions and a practice for everyday life, with Jane in Aylsham, North Norfolk."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">A private weekend introduction</p>
      <h1>Learn to meditate in a weekend</h1>
      <p class="lede">
        A private introduction to meditation held over a weekend at Jane's home
        in Aylsham, North Norfolk. The teaching and rhythm are shaped around
        you. Buddhist-informed but without doctrine or dogma: no beliefs
        required, no previous experience necessary.
      </p>
      <div class="button-row">
        <a class="button" href="mailto:hello@stillground.co.uk">Ask Jane about a weekend</a>
        <a class="button secondary" href={`${base}personal-retreats/`}>Personal retreats</a>
      </div>
    </div>
    <figure class="hero-media image-contain">
      <img
        src={`${base}assets/learn-to-meditate/meditation-room.webp`}
        alt="A quiet room set up with a mat, cushion, and singing bowl for meditation"
        width="760"
        height="463"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption>Private meditation teaching</figcaption>
    </figure>
  </section>

  <section class="statement">
    <p>
      One guest. One teacher. Unhurried, genuinely personalised, and built around
      you.
    </p>
  </section>

  <section class="feature-grid" aria-label="What is included">
    <article>
      <h3>Private teaching</h3>
      <p>
        Four individual meditation teaching sessions across the weekend, shaped
        around your needs, experience and interests.
      </p>
    </article>
    <article>
      <h3>Held weekend</h3>
      <p>
        A private ensuite room, nourishing vegan gluten-free meals, and spacious
        time to rest, walk, journal, or simply be.
      </p>
    </article>
    <article>
      <h3>Practice to take home</h3>
      <p>
        A written summary of your personal practice, plus a follow-up
        conversation two weeks after your return.
      </p>
    </article>
  </section>

  <section class="split">
    <div>
      <p class="eyebrow">Included</p>
      <h2>A complete weekend container</h2>
      <ul class="list-clean">
        <li>Private ensuite room for the weekend.</li>
        <li>Four individual meditation teaching sessions.</li>
        <li>Guided sits and time to practise at a pace that suits you.</li>
        <li>Nourishing home-cooked vegan, gluten-free meals throughout.</li>
        <li>Time for a walk along the coast or through North Norfolk countryside, if you enjoy walking.</li>
        <li>Spacious unstructured time to rest, walk, journal, or simply be.</li>
        <li>A written summary of your personal practice to take home.</li>
        <li>A follow-up conversation two weeks after your return.</li>
      </ul>
    </div>
    <div class="price-panel">
      <p class="small-label">Investment</p>
      <div id="meditation-intro-offer" hidden>
        <p class="small-label">Introductory offer</p>
        <strong>&pound;775</strong>
        <p>For bookings completed by 31 March 2027.</p>
      </div>
      <p>Standard price: <b>&pound;875</b></p>
      <p>A free 20-minute conversation is offered before booking.</p>
    </div>
  </section>

  <script is:inline>
    const offer = document.getElementById("meditation-intro-offer");
    const offerExpiry = Date.parse("2027-04-01T00:00:00+01:00");
    const updateOffer = () => {
      if (!offer) return;
      const remaining = offerExpiry - Date.now();
      if (remaining <= 0) {
        offer.remove();
        return;
      }
      offer.hidden = false;
      window.setTimeout(updateOffer, Math.min(remaining, 24 * 60 * 60 * 1000));
    };
    updateOffer();
  </script>

  <section class="section">
    <p class="eyebrow">The shape of the weekend</p>
    <h2>Simple, steady, and shaped around you</h2>
    <p>
      This is a possible outline, not a fixed timetable. The four teaching
      sessions and the overall rhythm are shaped around your needs, experience
      and interests, so your practice can fit into everyday life.
    </p>
    <div class="schedule">
      <article>
        <h3>Friday from 4pm</h3>
        <p>
          Arrive, settle in and share a welcome supper. We can talk about what
          you hope to explore and begin with a short sit.
        </p>
      </article>
      <article>
        <h3>Saturday</h3>
        <p>
          There is time for personal teaching, practice, rest and a shared
          dinner. We will shape the day together rather than follow a rigid
          schedule.
        </p>
      </article>
      <article>
        <h3>Sunday</h3>
        <p>
          We can consolidate what you have learned and make a daily practice
          that works for you, with lunch and departure when you are ready.
        </p>
      </article>
    </div>
    <p>
      There may be time for a walk along the coast or through the beautiful North
      Norfolk countryside. If you enjoy walking, we can make this part of our
      time together, using it as another opportunity to explore awareness and
      mindfulness outdoors. As with everything else over the weekend, it's
      something we can shape around you, your interests and what feels right.
    </p>
  </section>

  <section class="section section-narrow">
    <p class="eyebrow">Who this is for</p>
    <h2>A private way to begin properly</h2>
    <ul class="list-clean">
      <li>Anyone who has always wanted to learn but never quite got started.</li>
      <li>People who have tried apps or group classes and found them unsatisfying.</li>
      <li>
        Those going through stress, burnout, or a period of change who sense
        meditation might help.
      </li>
      <li>
        Anyone who wants to learn privately, without having to perform for a group.
      </li>
    </ul>
  </section>

  <section class="contact-band">
    <div>
      <p class="eyebrow">One weekend. A practice for life.</p>
      <h2>Leave with a daily practice that fits your actual life</h2>
      <p>
        The aim is confidence: a clear understanding of what meditation is, direct
        experience of sitting practice, and a simple routine you can sustain.
      </p>
    </div>
    <a class="button" href="mailto:hello@stillground.co.uk">Email Jane</a>
  </section>
</BaseLayout>
