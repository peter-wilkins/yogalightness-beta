---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="A Day of Meditation and Relaxation - Past Event | Still Ground"
  description="A past one-day meditation, gentle yoga, breathing, Yoga Nidra, vegan lunch, and relaxation retreat in Aylsham, Norfolk."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Past event: Saturday 4 July, Aylsham</p>
      <h1>A day of meditation and relaxation - past event</h1>
      <p class="lede">
        Step away from the everyday and settle into a full day of meditation,
        gentle yoga, breathing practices, deep rest, vegan food, and spacious
        time to simply be.
      </p>
    </div>
    <figure class="hero-media image-contain">
      <img
        src={`${base}assets/day-retreat/balance.webp`}
        alt="Stacked balancing stones reflected in still water at sunset"
        width="900"
        height="450"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption>Meditation and relaxation</figcaption>
    </figure>
  </section>

  <section class="statement">
    <p>
      Open to everyone, from complete beginners to experienced practitioners,
      including people who prefer chair-based movement.
    </p>
  </section>

  <section class="section testimonial-section">
    <p class="eyebrow">Kind words from the day</p>
    <div class="testimonial-grid">
      <blockquote>
        <p>
          I came to the workshop to gain a deeper understanding of meditation
          and I certainly have. The day was wonderful. Incredibly relaxing, the
          food was delicious and I felt very cared for. I would recommend to
          everyone!
        </p>
        <cite>T.F.</cite>
      </blockquote>
      <blockquote>
        <p>
          I had a very informative and relaxing day. Learnt a lot about Yoga
          Nidra which was fascinating. Food was great, imaginative and
          delicious. Well presented in a great setting. Made me feel very
          welcome.
        </p>
      </blockquote>
      <blockquote>
        <p>
          A wonderful day/workshop to be able to deepen, or even begin,
          meditation practice. A day to relax and learn about meditation in a
          wonderful home. Such care and attention paid to everything - the
          content, the atmosphere, the food.
        </p>
      </blockquote>
    </div>
  </section>

  <section class="split">
    <div>
      <p class="eyebrow">The day</p>
      <h2>Gentle structure, plenty of space</h2>
      <div class="schedule">
        <article>
          <h3>10:00am - 12:30pm</h3>
          <p>Morning meditation, gentle yoga stretches, and breathing practices.</p>
        </article>
        <article>
          <h3>12:30pm - 2:00pm</h3>
          <p>Homemade vegan lunch and spacious time to rest, read, or be quiet.</p>
        </article>
        <article>
          <h3>2:00pm - 3:00pm</h3>
          <p>Yoga Nidra, a guided deep relaxation practice.</p>
        </article>
        <article>
          <h3>3:00pm - 4:30pm</h3>
          <p>Afternoon meditation, tea, and closing space.</p>
        </article>
      </div>
    </div>
    <div class="note-panel">
      <p class="small-label">Included</p>
      <ul class="list-clean">
        <li>Guided meditation and breathing practices.</li>
        <li>Gentle, accessible yoga for all levels.</li>
        <li>Yoga Nidra deep relaxation.</li>
        <li>Homemade vegan lunch and refreshments.</li>
        <li>Outdoor space to enjoy, weather permitting.</li>
        <li>A small group, limited to 6 participants.</li>
      </ul>
    </div>
  </section>

  <section class="split">
    <div>
      <p class="eyebrow">Booking</p>
      <h2>Small, personal, and unhurried</h2>
      <p>
        The day is held in a calm private home setting in Aylsham, Norfolk. The
        exact address is shared with participants after booking.
      </p>
      <p>
        Places are limited so the day can stay personal, quiet, and well
        supported.
      </p>
    </div>
    <div class="price-panel">
      <p class="small-label">Reference price</p>
      <strong>&pound;115</strong>
      <p>For reference, this was the full price for the July day retreat.</p>
    </div>
  </section>
</BaseLayout>
