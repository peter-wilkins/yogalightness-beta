---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Autumn and Winter Workshops | Still Ground"
  description="Yoga Nidra Nights, Movement, Meditation and Relaxation sessions, a reflective Kundalini Yoga chakra study day, and the Monday practice group in Aylsham, Norfolk."
  showFounder={false}
>
  <section class="page-title section-narrow">
    <p class="eyebrow">Save the dates</p>
    <h1>Autumn and winter workshop schedule</h1>
    <p class="lede">
      Yoga Nidra Nights, movement, meditation, and relaxation in Aylsham.
      Booking is open for the first session. Full booking details for later
      dates will follow closer to each session.
    </p>
  </section>

  <section class="statement">
    <p>
      Most sessions are limited to a small group of around eight people, to keep
      things personal and intimate.
    </p>
  </section>

  <section class="feature-grid workshop-grid" aria-label="Autumn and winter workshop dates">
    <article>
      <p class="small-label">Monthly Fridays</p>
      <h3>Yoga Nidra Night</h3>
      <p>
        A monthly evening of guided Yoga Nidra: deep, restorative rest for the
        nervous system.
      </p>
      <p><strong>Fridays, 6:00-8:00pm | 2 hours | &pound;25</strong></p>
      <ul class="list-clean">
        <li>Friday 6 November</li>
        <li>Friday 4 December</li>
        <li>Friday 8 January</li>
        <li>Friday 5 February</li>
        <li>Friday 5 March</li>
        <li>Friday 2 April</li>
      </ul>
      <p>
        Booking is now open for Friday 6 November.
        <a href="mailto:hello@stillground.co.uk">Email Jane</a> to reserve your place.
        Book 6 November and 4 December together for &pound;40, saving &pound;10.
      </p>
    </article>

    <article>
      <p class="small-label">Monthly Saturdays</p>
      <h3>Movement, Meditation and Relaxation</h3>
      <p>
        An exploration of the deeper layers of Hatha Yoga &mdash; the symbolism,
        subtle energies and hidden meanings woven into its traditional
        practices. A chance to look beyond the familiar physical forms and
        discover the profound inner dimensions of this ancient yogic tradition,
        woven together with breathing practices, relaxation and meditation.
      </p>
      <p><strong>Saturdays, 10:00am-1:00pm | 3 hours | &pound;35</strong></p>
      <ul class="list-clean">
        <li>Saturday 12 December</li>
        <li>Saturday 16 January</li>
        <li>Saturday 20 February</li>
        <li>Saturday 17 April</li>
      </ul>
    </article>

    <article class="one-day-workshop">
      <p class="small-label">One-day workshop</p>
      <h3>Introduction to Kundalini Yoga: The Chakra System</h3>
      <p>
        A day of reflective study, exploring the chakras as a map of inner life
        in the Yasodhara tradition of Kundalini Yoga. No experience needed.
      </p>
      <p>
        In the Yasodhara tradition, Kundalini Yoga is a thoughtful, grounded
        path of self-understanding, and the chakras are its map: seven centres
        of awareness, each connected with different aspects of our lives, such
        as security, creativity, will, love, communication, insight and
        spiritual longing.
      </p>
      <p>
        This day takes you through the chakra system in an experiential way.
        We&rsquo;ll look at what each chakra represents, the symbols and sounds
        traditionally associated with it, and how these ideas can be used to
        reflect on your own experience, habits, patterns and potential.
      </p>
      <p>
        This is not the Kundalini Yoga taught by Yogi Bhajan. It draws on the
        approach developed at Yasodhara Ashram, which emphasises understanding,
        reflection and ethical living.
      </p>
      <p>
        Jane trained at Yasodhara Ashram in Canada in 2016, completed the
        Kundalini and Dream training in 2017, and has been teaching this work
        ever since.
      </p>
      <p>
        <strong>Saturday 20 March 2027 | 10am-5pm | &pound;100 including homemade
          vegan lunch</strong>
      </p>
      <p>&pound;90 early bird before 31 January 2027. Aylsham, Norfolk - address given on booking.</p>
      <p>Limited to around eight people.</p>
      <p>
        Bring a notebook and anything you need to be comfortable sitting for
        periods.
      </p>
    </article>

    <article>
      <p class="small-label">Weekly Mondays</p>
      <h3>Monday Group</h3>
      <p>
        The free Awakening Dignity Meditation group continues as usual.
      </p>
      <p><strong>Mondays, 9:30-11:00am | Free</strong></p>
      <p id="clocks-note" hidden>
        The clocks go back on Sunday 25 October, so Monday's 9:30am start will
        be GMT, not BST.
      </p>
      <script is:inline>
        const note = document.getElementById("clocks-note");
        const timeUntilExpiry = Date.parse("2026-10-27T00:00:00Z") - Date.now();
        if (note && timeUntilExpiry > 0) {
          note.hidden = false;
          window.setTimeout(() => note.remove(), timeUntilExpiry);
        } else {
          note?.remove();
        }
      </script>
      <a href={`${base}awakening-dignity/`}>Read about the practice group</a>
    </article>

    <article>
      <p class="small-label">Dates to follow</p>
      <h3>Day Retreat</h3>
      <p>
        A full day of meditation, movement, breathing, and Yoga Nidra, with a
        homemade vegan lunch. Held a few times a year.
      </p>
      <p><strong>&pound;115-&pound;125</strong></p>
      <a href={`${base}day-retreat/`}>See the most recent day retreat</a>
    </article>
  </section>

  <section class="section testimonial-section">
    <p class="eyebrow">Kind words</p>
    <div class="testimonial-grid">
      <blockquote>
        <p>
          Having attended Jane's dream workshops as well as working one to one,
          I have found her to be an invaluable guide in the exploration and
          understanding of hidden layers and symbolism.
        </p>
        <cite>K.L.</cite>
      </blockquote>
      <blockquote>
        <p>
          I came to the workshop to gain a deeper understanding of meditation
          and I certainly have. The day was wonderful. Incredibly relaxing, the
          food was delicious and I felt very cared for. I would recommend to
          everyone!
        </p>
        <cite>T.F.</cite>
      </blockquote>
    </div>
  </section>

  <section class="contact-band">
    <div>
      <p class="eyebrow">Register interest</p>
      <h2>Email Jane if a date calls to you</h2>
      <p>Full booking details for later dates will follow closer to each session.</p>
    </div>
    <a class="button" href="mailto:hello@stillground.co.uk">Email Jane</a>
  </section>
</BaseLayout>
